{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawcodex.dev/schemas/lkb/method-library-1.0.0.json",
  "title": "LKB Method Library",
  "type": "object",
  "required": ["schemaVersion", "methods"],
  "properties": {
    "schemaVersion": {"enum": ["1", "1.0.0"]},
    "schema_version": {"enum": ["1", "1.0.0"]},
    "min_lkb_version": {"type": "string"},
    "methods": {
      "type": "array",
      "items": {"$ref": "#/$defs/method"}
    }
  },
  "$defs": {
    "method": {
      "type": "object",
      "required": ["methodId", "pattern", "description", "subtaskTemplates"],
      "properties": {
        "methodId": {"type": "string", "pattern": "^M-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$"},
        "pattern": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "version": {"type": "string"},
        "status": {"enum": ["draft", "approved", "deprecated", "experimental"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "subtaskTemplates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/subtask"}
        },
        "acceptanceTemplate": {"$ref": "#/$defs/acceptance"}
      }
    },
    "subtask": {
      "type": "object",
      "required": ["templateId", "role", "subjectTemplate"],
      "properties": {
        "templateId": {"type": "string", "minLength": 1},
        "role": {"enum": ["design", "impl", "test", "docs", "review", "deploy"]},
        "subjectTemplate": {"type": "string", "minLength": 1},
        "descriptionTemplate": {"type": "string"},
        "acceptanceTemplate": {"type": "string"},
        "defaultBlockedBy": {"type": "array", "items": {"type": "string"}}
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["assertionTemplate"],
      "properties": {
        "assertionTemplate": {"type": "string", "minLength": 1},
        "proofTemplate": {"type": "string"},
        "strictAcceptance": {"type": "boolean"}
      }
    }
  }
}
