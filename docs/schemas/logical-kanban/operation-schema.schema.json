{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawcodex.dev/schemas/lkb/operation-schema-1.0.0.json",
  "title": "LKB Operation Schema",
  "oneOf": [
    {"$ref": "#/$defs/document"},
    {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    {"$ref": "#/$defs/operation"}
  ],
  "$defs": {
    "document": {
      "type": "object",
      "required": ["schema_version", "operations"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "min_lkb_version": {"type": "string"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}}
      }
    },
    "operation": {
      "type": "object",
      "required": ["operation_id", "description", "preconditions", "effects"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^OP-[a-z0-9]+(-[a-z0-9]+)*$"},
        "description": {"type": "string"},
        "preconditions": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*\\([^()]*\\)$"}},
        "effects": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*\\([^()]*\\)$"}},
        "estimated_duration_minutes": {"type": "integer", "minimum": 1},
        "required_resources": {"type": "array", "items": {"type": "string"}},
        "version": {"type": "string"}
      }
    }
  }
}
