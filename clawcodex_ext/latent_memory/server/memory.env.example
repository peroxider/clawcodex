# ClawCodex bundled memory configuration template.
# Copy this file to ~/.clawcodex/memory/memory.env and keep the real file private.

# -----------------------------------------------------------------------------
# Passive-memory integration (read by the ClawCodex process)
# -----------------------------------------------------------------------------
CLAWCODEX_PASSIVE_MEMORY=0
CLAWCODEX_PASSIVE_MEMORY_HUMAN_ID=
CLAWCODEX_PASSIVE_MEMORY_AGENT_ID=ccx:primary
CLAWCODEX_PASSIVE_MEMORY_RECALL_SCOPE=user
CLAWCODEX_PASSIVE_MEMORY_SEARCH_LIMIT=16
CLAWCODEX_PASSIVE_MEMORY_INJECT_LIMIT=3
CLAWCODEX_PASSIVE_MEMORY_MINIMUM_SCORE=0.50
CLAWCODEX_PASSIVE_MEMORY_SCORE_MARGIN=0.15
CLAWCODEX_PASSIVE_MEMORY_SEARCH_TIMEOUT_MS=5000
CLAWCODEX_PASSIVE_MEMORY_CAPTURE_MAX_TOKENS=8000
CLAWCODEX_PASSIVE_MEMORY_WRITE_QUEUE_SIZE=32
CLAWCODEX_PASSIVE_MEMORY_LOG_LEVEL=WARNING
CLAWCODEX_PASSIVE_MEMORY_LOG_FILE=

# -----------------------------------------------------------------------------
# REST service and state
# -----------------------------------------------------------------------------
MEMORY_SERVER_HOST=127.0.0.1
MEMORY_SERVER_PORT=8888
CLAWCODEX_MEMORY_LOG_LEVEL=info
COLLECTION_NAME=memories

# Leave CLAWCODEX_MEMORY_STATE_DIR unset to use ~/.clawcodex/memory.
# CLAWCODEX_MEMORY_STATE_DIR=D:/private/clawcodex-memory
# Leave Qdrant connection fields empty to use embedded Qdrant.
QDRANT_URL=
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Mem0 extraction LLM and embedder
# -----------------------------------------------------------------------------
# OpenAI-compatible cloud example. OPENAI_BASE_URL also supports compatible
# gateways; it does not change the main ClawCodex model provider.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# For local Ollama, change LLM_PROVIDER/EMBEDDER_PROVIDER to ollama, choose
# installed models, and set EMBEDDING_DIMS to the embedder's real dimensions.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional complete Mem0 YAML. Values in its explicit vector_store take priority.
MEM0_CONFIG_PATH=

# -----------------------------------------------------------------------------
# Salience gate
# -----------------------------------------------------------------------------
SALIENCE_GATE_ENABLED=true
# none/disabled/off: rule layers only; otherwise use the named Ollama model.
SALIENCE_GATE_OLLAMA_MODEL=none
SALIENCE_GATE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# -----------------------------------------------------------------------------
# Semantic crystallization (disabled by default)
# -----------------------------------------------------------------------------
CRYSTALLIZE_ENABLED=false
CRYSTALLIZE_THRESHOLD=20
CRYSTALLIZE_INTERVAL_HOURS=24
CRYSTALLIZE_SEARCH_STRATEGY=layered
CRYSTALLIZE_LLM_PROVIDER=ollama
CRYSTALLIZE_OLLAMA_MODEL=llama3.2:3b
CRYSTALLIZE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Used only when CRYSTALLIZE_LLM_PROVIDER=openai.
CRYSTALLIZE_OPENAI_MODEL=gpt-4o-mini
CRYSTALLIZE_OPENAI_BASE_URL=https://api.openai.com/v1
CRYSTALLIZE_OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Durable solidification (disabled by default)
# -----------------------------------------------------------------------------
SOLIDIFY_ENABLED=false
SOLIDIFY_DUAL_WRITE=true
SOLIDIFY_PROJECTION_MODE=async
SOLIDIFY_DOCUMENT_ENABLED=true
SOLIDIFY_DOC_GIT_ENABLED=true
SOLIDIFY_GRAPH_ENABLED=true
SOLIDIFY_MATURITY_ENABLED=true
