# install.sh and scripts/ci/local_publish.py create .env from this template.
# The real .env file is gitignored. Never commit real token values.

GITCODE_TOKEN=
TEST_PYPI_TOKEN=
# PYPI_TOKEN=

GITCODE_OWNER=
GITCODE_REPO=
GITCODE_API_ROOT=https://api.gitcode.com

# remote api token
API_SERVER_KEY=

# Bundled long-term memory (managed by `clawcodex-dev memory enable/disable`).
CLAWCODEX_PASSIVE_MEMORY=0
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDER_PROVIDER=openai
# EMBEDDER_MODEL=text-embedding-3-small
