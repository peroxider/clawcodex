-"""
-
-from __future__ import annotations
-
-import re
-
-_SPLIT_RE = re.compile(r"\s*(?:&&|\|\||[;])\s*")
-_SLEEP_RE = re.compile(r"^sleep\s+(\d+)\s*$")
