-    styling to those character ranges in a future PromptInput widget.
-    """
-    if not is_buddy_enabled():
-        return []
-    return [
-        {'start': m.start(), 'end': m.end()}
-        for m in _BUDDY_TRIGGER_RE.finditer(text)
-    ]
-
-
-__all__ = [
-    'find_buddy_trigger_positions',
-    'is_buddy_live',
