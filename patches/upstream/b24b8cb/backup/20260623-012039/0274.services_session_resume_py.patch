+                elif isinstance(content, list):
+                    _rewrite_content_list(content, old_cwd, new_cwd)
+
+    # ---- Fallback: rewrite content text ----
+    content = getattr(msg, "content", None) or ""
+    if isinstance(content, str) and old_cwd in content:
